<%- include('../../partials/header') %>
<main>
    <table class="user-table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Role</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            <% users.forEach(user => { %>
                <tr>
                    <td><%= user.email %></td>
                    <td><%= user.role %></td>
                    <td>
                        <% if (user.role !== 'admin') { %>
                            <form action="/users/promote/<%= user.email %>"
                                method="POST">
                                <button type="submit">
                                    Promote to Admin
                                </button>
                            </form>
                        <% } else { %>
                            <span>Administrator</span>
                        <% } %>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</main>
<%- include('../../partials/footer') %>