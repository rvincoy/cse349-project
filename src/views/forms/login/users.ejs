<%- include('../../partials/header') %>
<main>
    <table class="user-table" style="width: 50%;">
        <thead>
            <tr>
                <th style="text-align: left;">Email</th>
                <th style="text-align: left;">Role</th>
                <th style="text-align: left;">Action</th>
            </tr>
        </thead>

        <tbody>
            <% users.forEach(user => { %>
                <tr>
                    <td><%= user.email %></td>
                    <td><%= user.role %></td>
                    <td>
                        <% if (user.role !== 'admin') { %>
                            <form action="/users/promote/<%= user.id %>"
                                method="POST">
                                <button type="submit" style="background-color: palegreen;">
                                    Promote to Admin
                                </button>
                            </form>
                        <% } else { %>
                            <form action="/users/demote/<%= user.id %>"
                                method="POST">
                                <button type="submit" style="background-color: yellow;">
                                    Demote from Admin
                                </button>
                            </form>
                        <% } %>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</main>
<%- include('../../partials/footer') %>